local function RDTOGXK_fake_script() -- Orbit.FlyBox.FlyScript 
	local script = Instance.new('LocalScript', Orbit.FlyBox)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local textBox = script.Parent
	
	local flying = false
	local speed = 60
	
	local flyConnection
	local upHeld = false
	local downHeld = false
	
	local playerGui = player:WaitForChild("PlayerGui")
	
	local flyGui = Instance.new("ScreenGui")
	flyGui.Name = "FlyControls"
	flyGui.ResetOnSpawn = false
	flyGui.Enabled = false
	flyGui.Parent = playerGui
	
	local upButton = Instance.new("TextButton")
	upButton.Name = "Up"
	upButton.Size = UDim2.new(0, 70, 0, 70)
	upButton.Position = UDim2.new(1, -170, 1, -180)
	upButton.Text = "▲"
	upButton.TextScaled = true
	upButton.BackgroundTransparency = 0.2
	upButton.Parent = flyGui
	
	local downButton = Instance.new("TextButton")
	downButton.Name = "Down"
	downButton.Size = UDim2.new(0, 70, 0, 70)
	downButton.Position = UDim2.new(1, -170, 1, -95)
	downButton.Text = "▼"
	downButton.TextScaled = true
	downButton.BackgroundTransparency = 0.2
	downButton.Parent = flyGui
	
	upButton.MouseButton1Down:Connect(function()
		upHeld = true
	end)
	
	upButton.MouseButton1Up:Connect(function()
		upHeld = false
	end)
	
	upButton.MouseLeave:Connect(function()
		upHeld = false
	end)
	
	downButton.MouseButton1Down:Connect(function()
		downHeld = true
	end)
	
	downButton.MouseButton1Up:Connect(function()
		downHeld = false
	end)
	
	downButton.MouseLeave:Connect(function()
		downHeld = false
	end)
	
	local function stopFlying()
		flying = false
		upHeld = false
		downHeld = false
	
		if flyConnection then
			flyConnection:Disconnect()
			flyConnection = nil
		end
	
		flyGui.Enabled = false
	
		local character = player.Character
	
		if character then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
	
			if humanoid then
				humanoid.PlatformStand = false
			end
		end
	end
	
	local function startFlying()
		if flying then
			return
		end
	
		flying = true
		flyGui.Enabled = UserInputService.TouchEnabled
	
		flyConnection = RunService.RenderStepped:Connect(function()
			local character = player.Character
	
			if not character then
				return
			end
	
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
	
			if not humanoid or not rootPart then
				return
			end
	
			local camera = workspace.CurrentCamera
	
			humanoid.PlatformStand = true
	
			local moveDirection = humanoid.MoveDirection
	
			local horizontalDirection = Vector3.new(
				moveDirection.X,
				0,
				moveDirection.Z
			)
	
			local vertical = 0
	
			if upHeld then
				vertical = 1
			elseif downHeld then
				vertical = -1
			end
	
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				vertical = 1
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				vertical = -1
			end
	
			local velocity = horizontalDirection * speed
	
			velocity = Vector3.new(
				velocity.X,
				vertical * speed,
				velocity.Z
			)
	
			rootPart.AssemblyLinearVelocity = velocity
	
			local lookDirection = Vector3.new(
				camera.CFrame.LookVector.X,
				0,
				camera.CFrame.LookVector.Z
			)
	
			if lookDirection.Magnitude > 0 then
				rootPart.CFrame = CFrame.lookAt(
					rootPart.Position,
					rootPart.Position + lookDirection
				)
			end
		end)
	end
	
	textBox.FocusLost:Connect(function()
		local text = string.lower(textBox.Text)
	
		if text == "on" or text == "true" or text == "1" then
			textBox.Text = "ON"
			startFlying()
	
			if _G.CommandNotification then
				_G.CommandNotification("Fly enabled")
			end
	
		elseif text == "off" or text == "false" or text == "0" then
			textBox.Text = "OFF"
			stopFlying()
	
			if _G.CommandNotification then
				_G.CommandNotification("Fly disabled")
			end
		end
	end)
	
	player.CharacterAdded:Connect(function()
		if flying then
			task.wait(1)
			startFlying()
		end
	end)
end
coroutine.wrap(RDTOGXK_fake_script)()
local function VKLMIFG_fake_script() -- Orbit.TeleportBox.TeleportScript 
	local script = Instance.new('LocalScript', Orbit.TeleportBox)

	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local textBox = script.Parent
	
	local function findPlayer(name)
		name = string.lower(name)
	
		for _, target in ipairs(Players:GetPlayers()) do
			if string.lower(target.Name):sub(1, #name) == name then
				return target
			end
		end
	
		return nil
	end
	
	textBox.FocusLost:Connect(function()
		local target = findPlayer(textBox.Text)
	
		if not target then
			if _G.CommandNotification then
				_G.CommandNotification("Player not found")
			end
			return
		end
	
		local character = player.Character
		local targetCharacter = target.Character
	
		if character and targetCharacter then
			local root = character:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
			if root and targetRoot then
				root.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
	
				if _G.CommandNotification then
					_G.CommandNotification("Teleported to " .. target.Name)
				end
			end
		end
	end)
end
