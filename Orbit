local function PGQL_fake_script() -- Orbit.StopwatchFrame.StopWatchScript 
	local script = Instance.new('LocalScript', Orbit.StopwatchFrame)

	local RunService = game:GetService("RunService")
	
	local frame = script.Parent
	
	-- Find the timer label automatically
	local timeLabel
	
	for _, object in ipairs(frame:GetDescendants()) do
		if object:IsA("TextLabel") then
			if string.find(string.lower(object.Name), "time")
				or string.find(string.lower(object.Text), ":") then
				timeLabel = object
				break
			end
		end
	end
	
	-- If it can't find one, create it automatically
	if not timeLabel then
		timeLabel = Instance.new("TextLabel")
		timeLabel.Name = "TimeLabel"
		timeLabel.Size = UDim2.new(1, 0, 0, 50)
		timeLabel.Position = UDim2.new(0, 0, 0, 10)
		timeLabel.BackgroundTransparency = 1
		timeLabel.TextScaled = true
		timeLabel.Text = "00:00.00"
		timeLabel.Parent = frame
	end
	
	local running = false
	local elapsed = 0
	local startTime = 0
	local connection
	
	local function updateDisplay()
		local currentTime = elapsed
	
		if running then
			currentTime = elapsed + (os.clock() - startTime)
		end
	
		local minutes = math.floor(currentTime / 60)
		local seconds = math.floor(currentTime % 60)
		local milliseconds = math.floor((currentTime % 1) * 100)
	
		timeLabel.Text = string.format(
			"%02d:%02d.%02d",
			minutes,
			seconds,
			milliseconds
		)
	end
	
	local function startStopwatch()
		if running then
			return
		end
	
		running = true
		startTime = os.clock()
	
		if connection then
			connection:Disconnect()
		end
	
		connection = RunService.RenderStepped:Connect(updateDisplay)
	end
	
	local function stopStopwatch()
		if not running then
			return
		end
	
		elapsed += os.clock() - startTime
		running = false
	
		if connection then
			connection:Disconnect()
			connection = nil
		end
	
		updateDisplay()
	end
	
	local function resetStopwatch()
		running = false
		elapsed = 0
		startTime = 0
	
		if connection then
			connection:Disconnect()
			connection = nil
		end
	
		updateDisplay()
	end
	
	-- Automatically detect your buttons
	for _, object in ipairs(frame:GetDescendants()) do
		if object:IsA("TextButton") then
	
			local buttonText = string.lower(object.Text)
	
			if string.find(buttonText, "start") then
	
				object.Activated:Connect(function()
					startStopwatch()
				end)
	
			elseif string.find(buttonText, "stop") then
	
				object.Activated:Connect(function()
					stopStopwatch()
				end)
	
			elseif string.find(buttonText, "reset") then
	
				object.Activated:Connect(function()
					resetStopwatch()
				end)
			end
		end
	end
	
	updateDisplay()
end
