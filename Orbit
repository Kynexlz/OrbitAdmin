local function NXUNN_fake_script() -- Orbit.BrightnessFrame.BrightnessScript 
	local script = Instance.new('LocalScript', Orbit.BrightnessFrame)

	local UserInputService = game:GetService("UserInputService")
	local Lighting = game:GetService("Lighting")
	
	local frame = script.Parent
	local bar = frame:WaitForChild("BrightnessBar")
	local knob = bar:WaitForChild("BrightnessKnob")
	local valueLabel = frame:WaitForChild("BrightnessValue")
	
	local dragging = false
	
	-- Make sure the knob is positioned relative to the bar
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	
	local function setBrightnessFromX(x)
	
		local barWidth = bar.AbsoluteSize.X
		local knobWidth = knob.AbsoluteSize.X
	
		if barWidth <= knobWidth then
			return
		end
	
		-- Keep the CENTER of the knob inside the bar
		local left = knobWidth / 2
		local right = barWidth - (knobWidth / 2)
	
		-- Convert mouse position to position inside bar
		local relativeX = x - bar.AbsolutePosition.X
	
		-- Clamp it
		relativeX = math.clamp(relativeX, left, right)
	
		-- Calculate percentage
		local percentage = (relativeX - left) / (right - left)
	
		percentage = math.clamp(percentage, 0, 1)
	
		-- Move knob
		knob.Position = UDim2.new(
			0,
			relativeX,
			0.5,
			0
		)
	
		-- Change brightness
		Lighting.Brightness = percentage * 10
	
		-- Update text
		valueLabel.Text = math.floor(percentage * 100) .. "%"
	end
	
	-- Start dragging from the bar
	bar.InputBegan:Connect(function(input)
	
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
	
			dragging = true
	
			setBrightnessFromX(input.Position.X)
		end
	end)
	
	-- Start dragging from the knob
	knob.InputBegan:Connect(function(input)
	
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
	
			dragging = true
		end
	end)
	
	-- Move knob
	UserInputService.InputChanged:Connect(function(input)
	
		if not dragging then
			return
		end
	
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
	
			setBrightnessFromX(input.Position.X)
		end
	end)
	
	-- Stop dragging
	UserInputService.InputEnded:Connect(function(input)
	
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
	
			dragging = false
		end
	end)
	
	-- Start at 50%
	task.wait()
	
	setBrightnessFromX(
		bar.AbsolutePosition.X + (bar.AbsoluteSize.X / 2)
	)
end
