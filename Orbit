	local shownPosition = UDim2.new(0.5, 0, 0, 20)
	local hiddenPosition = UDim2.new(0.5, 0, 0, -80)
	
	local fadeInInfo = TweenInfo.new(
		0.35,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out
	)
	
	local fadeOutInfo = TweenInfo.new(
		0.3,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.In
	)
	
	notification.AnchorPoint = Vector2.new(0.5, 0)
	notification.Position = hiddenPosition
	notification.Visible = false
	
	local currentNotification = 0
	
	local function setTransparency(value)
		notification.BackgroundTransparency = value
	
		for _, object in ipairs(notification:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				object.TextTransparency = value
			elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
				object.ImageTransparency = value
			elseif object:IsA("UIStroke") then
				object.Transparency = value
			end
		end
	end
	
	local function showNotification(message)
		currentNotification += 1
		local thisNotification = currentNotification
	
		textLabel.Text = message
	
		notification.Visible = true
		notification.Position = hiddenPosition
		setTransparency(1)
	
		-- Smooth slide + fade in
		local fadeIn = TweenService:Create(
			notification,
			fadeInInfo,
			{
				Position = shownPosition,
				BackgroundTransparency = 0
			}
		)
	
		fadeIn:Play()
	
		for _, object in ipairs(notification:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				TweenService:Create(
					object,
					fadeInInfo,
					{TextTransparency = 0}
				):Play()
	
			elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
				TweenService:Create(
					object,
					fadeInInfo,
					{ImageTransparency = 0}
				):Play()
	
			elseif object:IsA("UIStroke") then
				TweenService:Create(
					object,
					fadeInInfo,
					{Transparency = 0}
				):Play()
			end
		end
	
		-- Stay visible for 2 seconds
		task.wait(2)
	
		-- Don't hide a newer notification
		if thisNotification ~= currentNotification then
			return
		end
	
		-- Smooth slide + fade out
		local fadeOut = TweenService:Create(
			notification,
			fadeOutInfo,
			{
				Position = hiddenPosition,
				BackgroundTransparency = 1
			}
		)
	
		fadeOut:Play()
	
		for _, object in ipairs(notification:GetDescendants()) do
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				TweenService:Create(
					object,
					fadeOutInfo,
					{TextTransparency = 1}
				):Play()
	
			elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
				TweenService:Create(
					object,
					fadeOutInfo,
					{ImageTransparency = 1}
				):Play()
	
			elseif object:IsA("UIStroke") then
				TweenService:Create(
					object,
					fadeOutInfo,
					{Transparency = 1}
				):Play()
			end
		end
	
		fadeOut.Completed:Wait()
	
		if thisNotification == currentNotification then
			notification.Visible = false
		end
	end
	
	_G.CommandNotification = showNotification
end
coroutine.wrap(XDWVR_fake_script)()



