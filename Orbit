local function LGRJ_fake_script() -- Orbit.EspBox.EspScript 
	local script = Instance.new('LocalScript', Orbit.EspBox)

	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local textBox = script.Parent
	
	local ESP_NAME = "CommandESP"
	
	local function addESP(target)
		if target == player then
			return
		end
	
		local character = target.Character
	
		if not character then
			return
		end
	
		-- Don't create duplicates
		if character:FindFirstChild(ESP_NAME) then
			return
		end
	
		local highlight = Instance.new("Highlight")
		highlight.Name = ESP_NAME
	
		highlight.FillColor = Color3.fromRGB(170, 255, 255)
		highlight.OutlineColor = Color3.fromRGB(170, 255, 255)
	
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
	
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	
		highlight.Parent = character
	end
	
	local function enableESP()
		for _, target in ipairs(Players:GetPlayers()) do
			addESP(target)
		end
	end
	
	-- Add ESP to players who join later
	Players.PlayerAdded:Connect(function(target)
		if _G.AllESPEnabled then
			target.CharacterAdded:Connect(function()
				task.wait(0.5)
				addESP(target)
			end)
		end
	end)
	
	-- Add ESP when characters respawn
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			target.CharacterAdded:Connect(function()
				if _G.AllESPEnabled then
					task.wait(0.5)
					addESP(target)
				end
			end)
		end
	end
	
	textBox.FocusLost:Connect(function()
		local text = string.lower(textBox.Text)
	
		if text == "on" or text == "true" or text == "1" then
			_G.AllESPEnabled = true
	
			enableESP()
	
			textBox.Text = "ON"
	
			if _G.CommandNotification then
				_G.CommandNotification("ESP enabled for all players")
			end
		end
	end)
end
