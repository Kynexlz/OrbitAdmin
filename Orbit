local function VZOUEFC_fake_script() -- Orbit.StickBox.BangScript 
	local script = Instance.new('LocalScript', Orbit.StickBox)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local textBox = script.Parent
	
	-- Shared state
	_G.StickTarget = nil
	_G.StickConnection = nil
	
	local function findPlayer(name)
		name = string.lower(name)
	
		if name == "" then
			return nil
		end
	
		-- Exact username first
		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player and string.lower(target.Name) == name then
				return target
			end
		end
	
		-- Partial username
		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player and string.lower(target.Name):sub(1, #name) == name then
				return target
			end
		end
	
		return nil
	end
	
	local function stopStick()
		_G.StickTarget = nil
	
		if _G.StickConnection then
			_G.StickConnection:Disconnect()
			_G.StickConnection = nil
		end
	end
	
	local function startStick(target)
		stopStick()
	
		_G.StickTarget = target
	
		_G.StickConnection = RunService.RenderStepped:Connect(function()
			if _G.StickTarget ~= target then
				return
			end
	
			if not target.Parent then
				stopStick()
	
				if _G.CommandNotification then
					_G.CommandNotification("Player left - Stick stopped")
				end
	
				return
			end
	
			local myCharacter = player.Character
			local targetCharacter = target.Character
	
			if not myCharacter or not targetCharacter then
				return
			end
	
			local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
			if not myRoot or not targetRoot then
				return
			end
	
			-- Stay 3 studs behind the target
			local targetCFrame = targetRoot.CFrame
			local targetPosition = targetCFrame.Position
			- targetCFrame.LookVector * 3
	
			-- Smoothly follow the target
			local newPosition = myRoot.Position:Lerp(
				targetPosition,
				0.35
			)
	
			myRoot.CFrame = CFrame.lookAt(
				newPosition,
				targetRoot.Position
			)
		end)
	end
	
	textBox.FocusLost:Connect(function()
		local target = findPlayer(textBox.Text)
	
		if not target then
			if _G.CommandNotification then
				_G.CommandNotification("Player not found")
			end
	
			return
		end
	
		startStick(target)
	
		if _G.CommandNotification then
			_G.CommandNotification("Sticking to " .. target.Name)
		end
	end)
end
